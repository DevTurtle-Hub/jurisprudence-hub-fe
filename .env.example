# URL của Spring Boot Backend API (Production)
# Nếu Frontend và Backend cùng chạy qua Reverse Proxy (Nginx) tại đường dẫn /api: để trống
# Nếu Frontend deploy trên domain riêng (Vercel, Netlify, Cloudflare Pages...): điền URL backend đầy đủ
# Ví dụ: VITE_API_URL=https://api.yourdomain.com
VITE_API_URL=
